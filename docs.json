          },
          {
            "group": "Features",
            "pages": [
              "features/semantic-search",
              "features/relationships",
              "features/document-search",
              "features/languages",
              "features/collaboration"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "workflows/tool-tiers",
              "workflows/piping",
              "contribute"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/cli",
              "reference/mcp-quick",
              "reference/mcp-persistent",
              "reference/mcp-network",
              "reference/https-setup",
              "reference/customization",
              "reference/debugging"
